.chart-maker-top-menu {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    overflow: visible;
}

.menu-dismiss-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    background-color: rgba(0, 0, 0, 0);
}

.top-menu-bar {
    height: 26px;
    min-height: 26px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-left: 4px;
    padding-right: 4px;
    background-color: rgb(230, 230, 230);
    border-bottom-width: 1px;
    border-bottom-color: rgb(166, 166, 166);
}

.top-menu-button {
    height: 25px;
    min-width: 46px;
    margin: 0;
    padding: 0 8px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(0, 0, 0);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 0;
    -unity-text-align: middle-center;
}

.top-menu-button:hover,
.top-menu-button:focus {
    background-color: rgb(209, 220, 235);
}

.top-menu-button:active {
    background-color: rgb(181, 204, 232);
}

.playback-menu-button {
    min-width: 72px;
}

.top-menu-spacer {
    flex-grow: 1;
}

.note-edit-window {
    position: absolute;
    top: 42px;
    right: 16px;
    display: none;
    width: 330px;
    background-color: rgb(246, 246, 246);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(120, 120, 120);
    border-right-color: rgb(120, 120, 120);
    border-top-color: rgb(120, 120, 120);
    border-bottom-color: rgb(120, 120, 120);
    border-radius: 4px;
}

.note-edit-title-bar {
    height: 30px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    background-color: rgb(224, 224, 224);
    border-bottom-width: 1px;
    border-bottom-color: rgb(168, 168, 168);
}

.note-edit-title {
    flex-grow: 1;
    color: rgb(0, 0, 0);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.note-edit-close-button {
    width: 30px;
    height: 29px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
}

.note-edit-close-button:hover {
    background-color: rgb(205, 72, 72);
    color: rgb(255, 255, 255);
}

.note-edit-content {
    padding-top: 10px;
    padding-right: 12px;
    padding-bottom: 8px;
    padding-left: 12px;
}

.note-edit-section-title {
    margin-bottom: 5px;
    color: rgb(0, 0, 0);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.note-edit-field-row {
    flex-direction: row;
}

.note-edit-field {
    min-height: 25px;
    margin-bottom: 4px;
    color: rgb(0, 0, 0);
    font-size: 12px;
    letter-spacing: 0;
}

.compact-field {
    flex-grow: 1;
    width: 50%;
}

.first-compact-field {
    margin-right: 6px;
}

.note-edit-field > .unity-base-field__label {
    min-width: 64px;
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
}

.compact-field > .unity-base-field__label {
    min-width: 54px;
}

.note-type-edit-panel {
    display: none;
    margin-top: 8px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgb(195, 195, 195);
}

.note-edit-meta {
    margin-top: 2px;
    color: rgb(72, 72, 72);
    font-size: 11px;
    letter-spacing: 0;
}

.note-edit-error {
    display: none;
    margin: 2px 12px 8px 12px;
    color: rgb(164, 35, 35);
    font-size: 11px;
    -unity-font-style: bold;
    white-space: normal;
    letter-spacing: 0;
}

.note-edit-actions {
    min-height: 38px;
    flex-direction: row;
    align-items: center;
    padding-right: 8px;
    padding-left: 8px;
    border-top-width: 1px;
    border-top-color: rgb(190, 190, 190);
}

.note-edit-action-spacer {
    flex-grow: 1;
}

.note-edit-action {
    min-width: 62px;
    height: 26px;
    margin-left: 5px;
    border-radius: 3px;
    color: rgb(0, 0, 0);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.danger-action {
    margin-left: 0;
    color: rgb(150, 30, 30);
}

.primary-action {
    background-color: rgb(55, 108, 166);
    color: rgb(255, 255, 255);
}

.menu-popup-host {
    position: absolute;
    top: 26px;
    left: 4px;
    display: none;
    width: auto;
    align-items: flex-start;
}

.menu-popup {
    display: none;
    width: auto;
    min-width: 0;
    align-self: flex-start;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: rgb(246, 246, 246);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(150, 150, 150);
    border-right-color: rgb(150, 150, 150);
    border-top-color: rgb(150, 150, 150);
    border-bottom-color: rgb(150, 150, 150);
}

.menu-item {
    height: 27px;
    width: auto;
    min-width: 0;
    margin: 0;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(0, 0, 0);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.menu-item:hover,
.menu-item:focus {
    background-color: rgb(209, 220, 235);
}

.menu-item:active {
    background-color: rgb(181, 204, 232);
}

.menu-separator {
    height: 1px;
    margin-top: 4px;
    margin-right: 8px;
    margin-bottom: 4px;
    margin-left: 8px;
    background-color: rgb(192, 192, 192);
}

.modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.35);
}

.modal-dialog {
    width: 380px;
    max-width: 90%;
    padding-top: 18px;
    padding-right: 18px;
    padding-bottom: 14px;
    padding-left: 18px;
    background-color: rgb(246, 246, 246);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(125, 125, 125);
    border-right-color: rgb(125, 125, 125);
    border-top-color: rgb(125, 125, 125);
    border-bottom-color: rgb(125, 125, 125);
    border-radius: 6px;
}

.modal-title {
    color: rgb(20, 20, 20);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.modal-message {
    margin-top: 10px;
    margin-bottom: 16px;
    color: rgb(45, 45, 45);
    font-size: 13px;
    white-space: normal;
    letter-spacing: 0;
}

.modal-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.modal-button {
    min-width: 76px;
    height: 28px;
    margin-left: 6px;
    border-radius: 4px;
    font-size: 13px;
    letter-spacing: 0;
}

.primary-button {
    background-color: rgb(55, 108, 166);
    color: rgb(255, 255, 255);
}

.danger-button {
    color: rgb(155, 35, 35);
}
